
<% if admin_signed_in? %>

  <main class="home-page catalog-page">

    <% if @works.any? %>

      <div class="home-works-grid">

        <% @works.each do |work| %>

          <article class="home-story-card">

            <%= link_to work_path(work),
                        class: "home-story-link" do %>

              <div class="home-story-cover">

                <% if work.cover.attached? %>

                  <%= image_tag work.cover,
                        alt: "Обложка произведения #{work.title}" %>

                <% else %>

                  <div class="home-story-cover-empty">
                    Нет обложки
                  </div>

                <% end %>

              </div>

              <div class="home-story-info">

                <div class="home-story-meta">

                  <span><%= work.rating %></span>

                  <span>
                    <%= {
                      "draft" => "Черновик",
                      "ongoing" => "В процессе",
                      "completed" => "Завершено",
                      "paused" => "На паузе"
                    }.fetch(work.status, work.status) %>
                  </span>

                  <% work.tags.each do |tag| %>
                    <span><%= tag.name %></span>
                  <% end %>

                </div>

                <h3><%= work.title %></h3>

                <p>
                  <%= truncate(work.summary, length: 160) %>
                </p>

              </div>

            <% end %>

          </article>

        <% end %>

      </div>

    <% else %>

      <div class="home-works-empty">
        Произведений пока нет.
      </div>

    <% end %>

  </main>

<% else %>

  <%= render "shared/launch" %>

<% end %>
