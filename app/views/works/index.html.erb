<h1>Каталог произведений</h1>

<% @works.each do |work| %>
  <article>
    <h2>
      <%= link_to work.title, work_path(work) %>
    </h2>

    <p>
      <strong>Автор:</strong>
      <%= work.user.username %>
    </p>

    <p>
      <strong>Фандом:</strong>
      <%= work.fandom.name %>
    </p>

    <p>
      <strong>Тип:</strong>
      <%= work.work_type %>
    </p>

    <p>
      <strong>Рейтинг:</strong>
      <%= work.rating %>
    </p>

    <p>
      <strong>Статус:</strong>
      <%= work.status %>
    </p>

    <p>
      <%= work.summary %>
    </p>

    <p>
      <strong>Теги:</strong>

      <% work.tags.each do |tag| %>
        <span><%= tag.name %></span>
      <% end %>
    </p>
  </article>

  <hr>
<% end %>