
<main class="fandom-show-page">

  <% fandom_images = {
    "Baldur's Gate 3" => "baldurs-gate-3.jpg",
    "Genshin Impact" => "genshin.jpg",
    "Гарри Поттер" => "dramione.jpg",
    "Ориджиналы" => "romance.jpg"
  } %>

  <section class="fandom-show-hero">

    <div class="fandom-show-cover">

      <% if fandom_images[@fandom.name] %>

        <%= image_tag "/fandoms/#{fandom_images[@fandom.name]}",
              alt: @fandom.name %>

      <% else %>

        <span><%= @fandom.name.to_s.first(1) %></span>

      <% end %>

    </div>

    <div class="fandom-show-info">

      <h1><%= @fandom.name %></h1>

      <% if @fandom.description.present? %>

        <div class="fandom-show-description">
          <%= simple_format(@fandom.description) %>
        </div>

      <% end %>

      <p class="fandom-show-count">
        Произведений: <%= @works.size %>
      </p>

    </div>

  </section>

  <section class="fandom-show-works">

    <div class="fandom-show-section-header">

      <h2>Произведения фэндома</h2>

      <span><%= @works.size %></span>

    </div>

    <% if @works.any? %>

      <div class="fandom-show-grid">

        <% @works.each do |work| %>

          <article class="fandom-work-card">

            <%= link_to work_path(work),
                        class: "fandom-work-link" do %>

              <div class="fandom-work-cover">

                <% if work.cover.attached? %>

                  <%= image_tag work.cover,
                        alt: "Обложка произведения #{work.title}" %>

                <% else %>

                  <div class="fandom-work-cover-empty">
                    Нет обложки
                  </div>

                <% end %>

              </div>

              <div class="fandom-work-info">

                <h3><%= work.title %></h3>

                <p class="fandom-work-author">
                  <%= work.user.username %>
                </p>

                <div class="fandom-work-meta">

                  <span><%= work.work_type %></span>

                  <span><%= work.rating %></span>

                </div>

                <% if work.summary.present? %>

                  <p class="fandom-work-summary">
                    <%= truncate(work.summary, length: 130) %>
                  </p>

                <% end %>

              </div>

            <% end %>

            <% if work.tags.any? %>

              <div class="fandom-work-tags">

                <% work.tags.each do |tag| %>
                  <span><%= tag.name %></span>
                <% end %>

              </div>

            <% end %>

          </article>

        <% end %>

      </div>

    <% else %>

      <div class="fandom-show-empty">

        <h3>Здесь пока нет произведений</h3>

        <p>
          Истории по этому фэндому ещё не опубликованы.
        </p>

      </div>

    <% end %>

  </section>

  <%= link_to "← Все фэндомы",
              fandoms_path,
              class: "fandom-show-back" %>

</main>
